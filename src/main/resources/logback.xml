<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 日志只写文件：stdout 属于 TUI -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${jaco.home}/logs/jaco.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${jaco.home}/logs/jaco.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{24} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="${jaco.log.level:-INFO}">
        <appender-ref ref="FILE"/>
    </root>
</configuration>
